# --- Database Configuration ---
# Optional: Single connection string for hosted PostgreSQL (Neon, Supabase, Railway, Render, etc.)
# If DATABASE_URL is set, it overrides PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
# DATABASE_URL=postgresql://user:password@ep-cool-site-123456.us-east-2.aws.neon.tech/sih26008?sslmode=require

PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=sih26008
PGUSER=postgres
PGPASSWORD=your_password_here

# --- Deployment Operating Mode ---
# LOCAL / HARDWARE MODE (Default):
# CLOUD_DEMO=false
# DATA_SOURCE=SIMULATOR (or ESP32 for physical hardware)

# PUBLIC CLOUD DEMO MODE (For PPT / Hosted judge demonstration without MQTT):
CLOUD_DEMO=false
DATA_SOURCE=SIMULATOR

# --- Device & Topic Defaults ---
DEVICE_ID=ESP32-01
TELEMETRY_TOPIC=sih26008/conveyor/ESP32-01/telemetry

# --- CORS Allowed Origins ---
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Environment Variables (Set in frontend/.env.local or cloud host) ---
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
